    "@dcloudio/uni-mp-weixin": "3.0.0-5030320261023001",
    "@noble/hashes": "^1.8.0",
    "vue": "3.4.21",
    "vue-i18n": "9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030320261023001",
    "@playwright/test": "1.58.0",
